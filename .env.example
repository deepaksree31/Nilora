# Copy to ".env" (or run: node scripts/init-env.js, which fills the secrets for you).
# NEVER commit .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=nilora
MYSQL_USER=nilora
MYSQL_PASSWORD=change_me_db

# --- MinIO (private song storage) ---
MINIO_ROOT_USER=nilora_minio
MINIO_ROOT_PASSWORD=change_me_minio_min8chars

# --- Secrets (24+ characters each) ---
JWT_SECRET=change_me_to_a_long_random_string
TICKET_SECRET=change_me_to_another_long_random_string

# --- Public addresses the BROWSER/APP uses (change when you go online) ---
PUBLIC_API_URL=http://localhost:8080
PUBLIC_STREAM_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:3000

# --- Development helpers (set to false when friends use it) ---
# true = signup returns the 6-digit code in the response so you can test without email
DEV_EXPOSE_OTP=true

# --- Email (optional; without it, codes are printed in the api logs) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
